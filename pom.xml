<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.finalshell</groupId>
  <artifactId>finalshell</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>FinalShell (readable rebuild)</name>
  <description>
    从 finalshell.jar 反编译重建的可读工程。第三方库按原包字节打包进 lib/bundled-libs.jar，
    与自研代码编译时依赖的 API 完全一致；每个库的上游坐标见 docs/DEPS.md。
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <bundled.libs.version>3.6</bundled.libs.version>
  </properties>

  <dependencies>
    <!-- 第三方库：从原 jar 切出，与编译期 API 完全一致（离线可用） -->
    <dependency>
      <groupId>com.finalshell</groupId>
      <artifactId>bundled-libs</artifactId>
      <version>${bundled.libs.version}</version>
    </dependency>

    <!-- BouncyCastle：原包通过 Class-Path: lib-run/bcprov.jar 外置加载 -->
    <dependency>
      <groupId>com.finalshell</groupId>
      <artifactId>bcprov</artifactId>
      <version>1.78</version>
    </dependency>

    <!-- javax.mail：原 jar 里没有这两个类（该 build 的邮件功能运行时本就是坏的），
         补上才能编译 u2_2.java / zU.java 这两个用到邮件的源文件 -->
    <dependency>
      <groupId>com.sun.mail</groupId>
      <artifactId>javax.mail</artifactId>
      <version>1.6.2</version>
    </dependency>
    <dependency>
      <groupId>javax.activation</groupId>
      <artifactId>javax.activation-api</artifactId>
      <version>1.2.0</version>
    </dependency>

    <!-- 混合构建兜底：未恢复到可编译状态的类使用原始字节码（hybrid-build 分支） -->
    <dependency>
      <groupId>com.finalshell</groupId>
      <artifactId>fallback-classes</artifactId>
      <version>1.0</version>
    </dependency>

    <!--
      Lombok 不再作为依赖声明：
        · 重建后的源码里 0 处 import lombok、0 处 lombok 注解、0 个 .SCL.lombok 标记文件
        · lombok 的 818 个类已经随原 jar 一起切进 lib/bundled-libs.jar，编译期可用
        · 保留这条远程坐标会让"离线构建"失效（需要联网从仓库拉 lombok）
    -->
  </dependencies>

  <build>
    <finalName>finalshell</finalName>
    <plugins>
      <!-- 把 lib/*.jar 安装进本地仓库，让上面的 dependency 生效 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-install-plugin</artifactId>
        <version>3.1.1</version>
        <executions>
          <execution>
            <id>install-bundled-libs</id>
            <phase>validate</phase>
            <goals><goal>install-file</goal></goals>
            <configuration>
              <file>${project.basedir}/lib/bundled-libs.jar</file>
              <groupId>com.finalshell</groupId>
              <artifactId>bundled-libs</artifactId>
              <version>${bundled.libs.version}</version>
              <packaging>jar</packaging>
            </configuration>
          </execution>
          <execution>
            <id>install-bcprov</id>
            <phase>validate</phase>
            <goals><goal>install-file</goal></goals>
            <configuration>
              <file>${project.basedir}/lib/bcprov.jar</file>
              <groupId>com.finalshell</groupId>
              <artifactId>bcprov</artifactId>
              <version>1.78</version>
              <packaging>jar</packaging>
            </configuration>
          </execution>
          <execution>
            <id>install-javax-mail</id>
            <phase>validate</phase>
            <goals><goal>install-file</goal></goals>
            <configuration>
              <file>${project.basedir}/lib/javax.mail-1.6.2.jar</file>
              <groupId>com.sun.mail</groupId>
              <artifactId>javax.mail</artifactId>
              <version>1.6.2</version>
              <packaging>jar</packaging>
            </configuration>
          </execution>
          <execution>
            <id>install-javax-activation</id>
            <phase>validate</phase>
            <goals><goal>install-file</goal></goals>
            <configuration>
              <file>${project.basedir}/lib/javax.activation-api-1.2.0.jar</file>
              <groupId>javax.activation</groupId>
              <artifactId>javax.activation-api</artifactId>
              <version>1.2.0</version>
              <packaging>jar</packaging>
            </configuration>
          </execution>
          <execution>
            <id>install-fallback-classes</id>
            <phase>validate</phase>
            <goals><goal>install-file</goal></goals>
            <configuration>
              <file>${project.basedir}/lib/fallback-classes.jar</file>
              <groupId>com.finalshell</groupId>
              <artifactId>fallback-classes</artifactId>
              <version>1.0</version>
              <packaging>jar</packaging>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <compilerArgs>
            <!-- 反编译产物里混着 'var'、'_' 这类新版关键字用法 -->
            <arg>-Xlint:none</arg>
            <arg>-nowarn</arg>
            <!-- javac 默认只报前 100 个错误，会把真实剩余量严重低估 -->
            <arg>-Xmaxerrs</arg>
            <arg>100000</arg>
          </compilerArgs>
          <showWarnings>false</showWarnings>
          <failOnWarning>false</failOnWarning>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.finalshell.core.St_2</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <!-- 一键打成可执行 jar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <descriptorRefs>
            <descriptorRef>jar-with-dependencies</descriptorRef>
          </descriptorRefs>
          <archive>
            <manifest>
              <mainClass>com.finalshell.core.St_2</mainClass>
            </manifest>
          </archive>
          <appendAssemblyId>false</appendAssemblyId>
          <finalName>finalshell</finalName>
        </configuration>
        <executions>
          <execution>
            <id>make-assembly</id>
            <phase>package</phase>
            <goals><goal>single</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
